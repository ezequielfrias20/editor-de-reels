# claves
.env

# metraje y renders: pesados y regenerables o irrepetibles, fuera del repo
VIDEOS ORIGINALES/
VIDEOS EDITADOS/
out/
videos/*/output*.mp4
videos/*/public/input-video.mp4
videos/*/public/snapshots/
videos/*/public/fonts/
videos/*/public/vendor/
videos/*/public/sfx/
videos/*/public/gen/
videos/*/.pf900.ttf

# audio intermedio
assets/audio/
*.wav
*.flac

# assets generados con IA: el ledger SÍ se versiona (reproduce los prompts)
assets/gen/*
!assets/gen/ledger.json

node_modules/
.venv/
.uv-cache/
__pycache__/
cache/
videos/*/review-snapshots/

.pytest_cache/

# spikes desechables (Tarea 8): se reconstruyen desde el doc del spike.
# Anclado a la raíz — sin la barra inicial también habría ignorado
# docs/superpowers/spikes/, que sí se versiona.
/spikes/

# datos de prueba: el audio de la pieza 14 lo necesitan voicing y plan-cuts
!tests/fixtures/assets/audio/*.flac

# render: lo arma build-composition.py desde el plan (se regenera entero)
videos/*/public/
videos/*/snapshots/
videos/*/storyboard.json
videos/*/.inter*.ttf
# caché de tipografías que mide el texto de los mockups
.claude/skills/video-tech-premium/assets/.inter*.ttf
