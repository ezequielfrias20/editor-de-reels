    },
    {
      "metric": "special_transition_ratio",
      "max": 0.2,
      "severity": "warn"
    },
    {
      "metric": "sfx_per_macro",
      "max": 0.5,
      "severity": "warn"
    },
    {
      "metric": "decorative_reason_count",
      "max": 0,
      "severity": "warn"
    },
    {
      "metric": "min_camera_gap",
      "min": 0.7,
      "severity": "warn"
